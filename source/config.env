# config.env: names, versions and pins. Read by modalapp/build.py, container/*.sh and package/mkipk.py.
# Plain KEY=VALUE lines.

# Cloud builder (optional, modalapp/build.py): app and volume names
MODAL_APP=chromium-webos
MODAL_VOLUME=chromium-webos

# Sysroot without TV files: pinned Ubuntu packages + stub libraries from container/tvabi (build-sysroot.sh)
SYSROOT_SOURCE=public

C151_REPO=https://github.com/webOS-ports/chromium151
C151_COMMIT=0baacb2b1a4b885826fed5493262f759c6a5b469
NODE_VERSION=v24.12.0
NINJA_VERSION=1.12.1
BUILD_CPU=64
BUILD_MEM_MIB=294912
BUILD_DISK_MIB=1048576   # ephemeral_disk for build(): build tree on real disk (2026-10-30, eviction fix)
CCACHE_MAXSIZE=30G
TV_GLIBC_MAX=2.24   # lowest glibc the beta binary needs (webOS 4.4 TVs); check-abi.py refuses to run without it
TV_LOADER=/lib/ld-linux.so.3
APP_ID=org.nphil.lumabrowser   # LumaBrowser fork; upstream ids were io.github.sarahahzub.chromium and org.nativechromium.browser
APP_TITLE="LumaBrowser"
VARIANT=compat
NINJA_KEEP_GOING=1
BUILDROOT_REPO=https://github.com/openlgtv/buildroot-nc4
BUILDROOT_BRANCH=2026.08.x
BUILDROOT_COMMIT=322ff04e625a7927338c2ac5f3d02cd0511c9b90
NSS_VERSION=3.125     # shipped in <app>/lib (MPL-2.0)
NSPR_VERSION=4.38.2   # shipped in <app>/lib (MPL-2.0)
SDK_TAG=2026.08-webos
SDK_URL_X86_64=https://github.com/openlgtv/buildroot-nc4/releases/download/2026.08-webos/arm-webos-linux-gnueabi_sdk-buildroot-x86_64.tar.gz
SDK_SHA256_X86_64=2230a6351e5cce6fcb9d4fdcb4697335f223995401ef969c81744aaeb14c5344
SDK_URL_AARCH64=https://github.com/openlgtv/buildroot-nc4/releases/download/2026.08-webos/arm-webos-linux-gnueabi_sdk-buildroot-aarch64.tar.gz
SDK_SHA256_AARCH64=3a9330f3789f8008ece7c8a48f58c3a71d0307a9a1f81896db938b785524c3ce
NSS_TARBALL_URL=https://ftp.mozilla.org/pub/mozilla.org/security/nss/releases/NSS_3_125_RTM/src/nss-3.125.tar.gz
NSS_TARBALL_SHA256=1ad541f10da7c58dec01f540ecc44d28cbbc033f741a57473de5a0893d91606d
NSPR_TARBALL_URL=https://ftp.mozilla.org/pub/mozilla.org/nspr/releases/v4.38.2/src/nspr-4.38.2.tar.gz
NSPR_TARBALL_SHA256=e4092faeab77bdc9b32db1113e4215948ee768e26c4666db3b5a60b35f2c9105
